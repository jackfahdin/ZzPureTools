         return true;
     }
 
-    auto remaining = src->timerList.timerWait().value_or(-1ms);
-    *timeout = q26::saturating_cast<gint>(ceil<milliseconds>(remaining).count());
+    const auto remaining = src->timerList.timerWait();
+    if (!remaining) {
+        g_source_set_ready_time(source, -1);
+        return false;
+    }
 
-    return (*timeout == 0);
+    // The prepare timeout is milliseconds; ready_time lets GLib retain
+    // microsecond precision on backends that support it.
+    const auto delay = ceil<microseconds>(*remaining).count();
+    const auto deadline = (src->timerList.currentTime + *remaining).time_since_epoch().count();
+    if (delay == 0) {
+        g_source_set_ready_time(source, 0);
+    } else if (g_source_get_ready_time(source) == -1 || lastDeadline != deadline) {
+        // Setting a changed ready_time wakes the context. Map an unchanged Qt
+        // deadline only once, avoiding prepare/poll self-wakeup loops and
+        // avoiding assumptions about the epochs of the two monotonic clocks.
+        lastDeadline = deadline;
+        g_source_set_ready_time(source, g_get_monotonic_time() + delay);
+    }
+    return delay == 0;
 }
 
