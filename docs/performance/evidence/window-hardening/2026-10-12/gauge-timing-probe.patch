+#include <QtCore/QJsonObject>
+
+// Diagnostic-only wrapper: all production Paint events still run normally.
+class DiagnosticApplication final : public QApplication
+{
+public:
+    using QApplication::QApplication;
+    QObject *gauge = nullptr;
+    bool measuring = false;
+    QElapsedTimer tickClock;
+    qint64 previousTick = -1;
+    QJsonArray paintDurations;
+    QJsonArray animationIntervals;
+
+    bool notify(QObject *receiver, QEvent *event) override
+    {
+        if (!measuring || receiver != gauge || event->type() != QEvent::Paint) {
+            return QApplication::notify(receiver, event);
+        }
+        QElapsedTimer clock;
+        clock.start();
+        const bool result = QApplication::notify(receiver, event);
+        paintDurations.append(static_cast<double>(clock.nsecsElapsed()) / 1e6);
+        return result;
+    }
+
+    void tick()
+    {
+        if (!measuring) return;
+        const qint64 now = tickClock.nsecsElapsed();
+        if (previousTick >= 0) {
+            animationIntervals.append(static_cast<double>(now - previousTick) / 1e6);
+        }
+        previousTick = now;
+    }
+
+    bool saveDiagnostics(const QString &path)
+    {
+        QFile file(path);
+        if (!file.open(QIODevice::WriteOnly)) return false;
+        const QByteArray json = QJsonDocument(QJsonObject{
+            {QStringLiteral("purpose"), QStringLiteral("diagnostic only; not a reference baseline")},
+            {QStringLiteral("unit"), QStringLiteral("ms")},
+            {QStringLiteral("paintEventDispatchDurations"), paintDurations},
+            {QStringLiteral("animationValueChangedIntervals"), animationIntervals}
+        }).toJson();
+        return file.write(json) == json.size();
+    }
+};
+
