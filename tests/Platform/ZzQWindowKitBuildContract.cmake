cmake_minimum_required(VERSION 3.23)

foreach(required IN ITEMS ZZ_SOURCE_DIR ZZ_TEST_ROOT)
    if(NOT DEFINED ${required} OR NOT IS_ABSOLUTE "${${required}}")
        message(FATAL_ERROR "${required} must be an absolute path")
    endif()
endforeach()
if(DEFINED ZZ_BINARY_ROOT AND IS_ABSOLUTE "${ZZ_BINARY_ROOT}")
    set(build_root "${ZZ_BINARY_ROOT}")
else()
    set(build_root "${ZZ_SOURCE_DIR}/build")
endif()
cmake_path(IS_PREFIX build_root "${ZZ_TEST_ROOT}" NORMALIZE safe_root)
if(NOT safe_root OR "${ZZ_TEST_ROOT}" STREQUAL "${build_root}")
    message(FATAL_ERROR "Test root must be below the supplied build directory")
endif()
file(REMOVE_RECURSE "${ZZ_TEST_ROOT}")
include("${ZZ_SOURCE_DIR}/ZzThirdParty/qwindowkit/cmake/WriteIfDifferent.cmake")
include("${ZZ_SOURCE_DIR}/ZzThirdParty/qwindowkit/cmake/SyncHeaders.cmake")

function(zz_check_headers windows_mode)
    set(WIN32 "${windows_mode}")
    set(test_root "${ZZ_TEST_ROOT}/${windows_mode}")
    set(source_dir "${test_root}/source")
    set(output_dir "${test_root}/output")
    set(unresolved_length 0)
    while(unresolved_length LESS 245)
        string(APPEND output_dir "/nest")
        file(RELATIVE_PATH reference "${output_dir}/QWKFixture" "${source_dir}/agent.h")
        string(LENGTH "${output_dir}/QWKFixture/${reference}" unresolved_length)
    endwhile()
    set(CMAKE_CURRENT_BINARY_DIR "${test_root}/records")
    file(MAKE_DIRECTORY "${source_dir}/style" "${source_dir}/internal")
    file(WRITE "${source_dir}/agent.h" "#pragma once\n")
    file(WRITE "${source_dir}/internal/agent_p.h" "#pragma once\n")
    file(WRITE "${source_dir}/style/styleagent.h" "#pragma once\n")
    file(WRITE "${source_dir}/obsolete.h" "#pragma once\n")
    qwk_sync_headers(QWKFixture BUILD_DIR "${output_dir}" SOURCE_DIR "${source_dir}" EXCLUDE "^style/")
    file(WRITE "${output_dir}/QWKFixture/config.h" "unmanaged configuration\n")
    file(REMOVE "${source_dir}/obsolete.h")
    qwk_sync_headers(QWKFixture BUILD_DIR "${output_dir}" SOURCE_DIR "${source_dir}" EXCLUDE "^style/")
    if(EXISTS "${output_dir}/QWKFixture/obsolete.h" OR EXISTS "${output_dir}/QWKFixture/styleagent.h")
        message(FATAL_ERROR "Stale or excluded forwarding header remains")
    endif()
    if(NOT EXISTS "${output_dir}/QWKFixture/config.h")
        message(FATAL_ERROR "Header synchronization removed an unrelated generated file")
    endif()
    foreach(header IN ITEMS agent.h private/agent_p.h)
        file(READ "${output_dir}/QWKFixture/${header}" forwarding)
        string(REGEX MATCH "#include \"([^\"]+)\"" matched "${forwarding}")
        set(reference "${CMAKE_MATCH_1}")
        get_filename_component(destination "${output_dir}/QWKFixture/${header}" DIRECTORY)
        if(header MATCHES "private/")
            set(original "${source_dir}/internal/agent_p.h")
        else()
            set(original "${source_dir}/agent.h")
        endif()
        file(RELATIVE_PATH relative "${destination}" "${original}")
        string(LENGTH "${destination}/${relative}" unresolved_length)
        if(unresolved_length LESS 240)
            message(FATAL_ERROR "Fixture does not reproduce a long unnormalized include")
        endif()
        if(windows_mode AND NOT IS_ABSOLUTE "${reference}")
            message(FATAL_ERROR "Windows long forwarding include must be normalized absolute: ${reference}")
        elseif(NOT windows_mode AND IS_ABSOLUTE "${reference}")
            message(FATAL_ERROR "Non-Windows forwarding include must stay relative")
        endif()
        get_filename_component(resolved "${reference}" ABSOLUTE BASE_DIR "${destination}")
        if(NOT resolved STREQUAL original)
            message(FATAL_ERROR "Forwarding header does not resolve to its source")
        endif()
    endforeach()
endfunction()

zz_check_headers(FALSE)
zz_check_headers(TRUE)
message(STATUS "QWindowKit forwarding headers and Windows long paths verified")
